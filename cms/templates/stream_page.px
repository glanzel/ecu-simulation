from pyjsx import jsx
from pyjsx.jsx import HTMLDontEscape

from ui.web.layout import site_layout


def streamPage(*, page, context):
    menu_items = context.get("menu_items", [])
    footer_items = context.get("footer_items", [])
    nav_links = [(item.label, item.href) for item in menu_items]
    footer_links = [(item.label, item.href) for item in footer_items]
    stream_html = context.get("stream_html", "")
    stream_block = (
        <div class="cms-content not-prose">{HTMLDontEscape(stream_html)}</div>
        if stream_html
        else <p class="text-slate-500 text-sm">Noch kein Stream-Inhalt.</p>
    )
    return site_layout(
        title=f"{page.title} — ECU",
        nav_links=nav_links,
        footer_links=footer_links,
        locale_links=context.get("locale_switch_links"),
        language_code=context.get("language_code", "de"),
        main_class="prose prose-slate prose-lg max-w-5xl mx-auto px-4 py-10",
        content=[
            <h1 class="not-prose text-[2rem] leading-tight font-semibold tracking-tight text-slate-900 mt-0 mb-[1.2rem]">{page.title}</h1>,
            stream_block,
        ],
    )
